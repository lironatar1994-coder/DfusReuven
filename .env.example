# ---------------------------------------------------------------------------
# דפוס ראובן — משתני סביבה
# העתיקו לקובץ .env.local לפיתוח מקומי. בפרודקשן הערכים מוזרקים ע"י deploy_linux.sh
# ---------------------------------------------------------------------------

# כתובת האתר המלאה (משמשת ל-canonical, sitemap, Open Graph ו-JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.dfusreuven.co.il

# האם לאפשר אינדוקס במנועי חיפוש. "true" רק בדומיין הסופי.
# בסביבת ה-subpath של vee-app.co.il יש להשאיר false.
NEXT_PUBLIC_ALLOW_INDEXING=false

# תת-נתיב, כשהאתר מוגש תחת vee-app.co.il/DfusReuven
# משאירים ריק בדומיין הסופי.
NEXT_BASE_PATH=
NEXT_PUBLIC_BASE_PATH=

# היכן נשמרות בקשות הצעות המחיר והקבצים המצורפים.
# חייב להיות נתיב שנשמר בין דיפלויים — לא בתוך תיקיית הפרויקט.
QUOTE_STORAGE_DIR=/var/lib/dfus-reuven/quotes

# אופציונלי: כתובת webhook שתקבל כל פנייה חדשה כ-JSON
# (למשל Zapier/Make לשליחת מייל, או ערוץ בסלאק).
# הפנייה נשמרת לדיסק בכל מקרה, גם אם ה-webhook נכשל.
QUOTE_WEBHOOK_URL=

# אופציונלי: סוד לחתימת ה-webhook. כשהוא מוגדר, כל קריאה נושאת כותרת
# x-dr-signature: sha256=<hmac> על גוף הבקשה המדויק. בלעדיו כל מי שמכיר
# את כתובת ה-webhook יכול להזריק פניות מזויפות.
QUOTE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# התראות על פניות חדשות
# בלי אלה הפנייה נשמרת לדיסק אבל אף אחד לא מקבל הודעה — צריך לפתוח את /admin.
# חשוב: בלי SPF ו-DKIM על הדומיין המיילים יגיעו לספאם.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
LEAD_NOTIFY_TO=R88000@gmail.com
LEAD_NOTIFY_FROM=leads@dfusreuven.co.il

# ---------------------------------------------------------------------------
# ממשק הניהול ב-/admin (רשימת הפניות והקבצים המצורפים)
# בלי שני המשתנים האלה ה-/admin מחזיר 503 וחוסם הכול — זו התנהגות מכוונת.
# ליצירת ה-hash:  node -e "console.log(require('crypto').createHash('sha256').update('הסיסמה').digest('hex'))"
# ---------------------------------------------------------------------------
ADMIN_USER=
ADMIN_PASSWORD_SHA256=
